---
/*
 * Starlight's header with a three-column grid on wide screens (1024px and
 * above): the logo block on the left, the navigation centered on the page
 * in the middle column, and the actions (search, GitHub, Matrix, theme
 * switch) on the right. The middle column is sized by its content and the
 * side columns share the remaining space equally, so the navigation stays
 * centered on the page while both side blocks fit in their share. A long
 * title is clipped. Wide actions push the navigation off center instead of
 * overlapping it.
 *
 * Overriding the component replaces Starlight's own header element, so its
 * scoped styles no longer apply: the base rules below copy them.
 * tests/header-override.test.mjs fails when a Starlight update changes its
 * header, so that the copy is compared before the update is merged. Below
 * 1024px nothing changes: the actions wrapper is display: contents, so the
 * search and the right group are direct children of the header as in
 * Starlight's own header, and the navigation is hidden (the mobile menu
 * keeps the flat `navLinks` of astro.config.mjs).
 *
 * The DOM order is the focus order: logo, navigation, search, links, theme.
 */
import config from "virtual:starlight/user-config";
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import HeaderNav from "./HeaderNav.astro";

/**
 * Render the `Search` component if Pagefind is enabled or the default search component has been overridden.
 */
const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== "@astrojs/starlight/components/Search.astro";
---

<div class="header">
  <div class="title-wrapper sl-flex"><SiteTitle /></div>
  <HeaderNav />
  <div class="header-actions">
    {
      shouldRenderSearch && (
        <div class="sl-flex print:hidden">
          <Search />
        </div>
      )
    }
    <div class="sl-hidden md:sl-flex print:hidden right-group">
      <div class="sl-flex social-icons"><SocialIcons /></div>
      <ThemeSelect />
      <LanguageSelect />
    </div>
  </div>
</div>

<style>
  /* Starlight's own header styles, copied because overriding the component
     replaces the element they are scoped to. They stay in Starlight's
     `starlight.core` layer, as in Starlight: the theme restyles some of
     these elements (for example `.social-icons::after`) from its own,
     later layer, and unlayered copies would win over the theme. The rules
     for 1024px and above below are unlayered on purpose: the theme sets
     the header padding from its layer, and these rules must override it. */
  @layer starlight.core {
    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }

    .title-wrapper {
      /* Prevent long titles overflowing and covering the search and menu
         buttons on narrow viewports. */
      overflow: clip;
      /* Avoid clipping focus ring around link inside title wrapper. */
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
    }

    .right-group,
    .social-icons {
      gap: 1rem;
      align-items: center;
    }

    .social-icons::after {
      content: "";
      height: 2rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
    }

    @media (min-width: 50rem) {
      :global(:root[data-has-sidebar]) {
        --__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
      }
      :global(:root:not([data-has-toc])) {
        --__toc-width: 0rem;
      }
      .header {
        --__sidebar-width: max(
          0rem,
          var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x)
        );
        --__main-column-fr: calc(
          (
              100% + var(--__sidebar-pad, 0rem) -
                var(--__toc-width, var(--sl-sidebar-width)) -
                (2 * var(--__toc-width, var(--sl-nav-pad-x))) -
                var(--sl-content-inline-start, 0rem) - var(--sl-content-width)
            ) / 2
        );
        display: grid;
        grid-template-columns:
          /* 1 (site title): runs up until the main content column's left edge
             or the width of the title, whichever is the largest */
          minmax(
            calc(
              var(--__sidebar-width) +
                max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))
            ),
            auto
          )
          /* 2 (search box): all free space that is available. */
          1fr
          /* 3 (right items): use the space that these need. */
          auto;
        align-content: center;
      }
    }
  }

  /* Below 1024px the wrapper disappears from the layout, so the search and
     the right group behave as direct children of the header. */
  .header-actions {
    display: contents;
  }

  /* Below 352px the logo block, the search button and the right group no
     longer fit with the full gap. A smaller gap and no separator between
     the social links and the theme switch keep the title wrapper from
     clipping the menu button down to a width of 320px. */
  @media (max-width: 22rem) {
    .header {
      gap: 0.5rem;
    }

    .social-icons::after {
      display: none;
    }
  }

  @media (min-width: 64rem) {
    .header {
      /* The left column may shrink to zero, so a long title is clipped by
         its wrapper instead of overlapping the navigation. The right
         column keeps the width of its content: wide actions push the
         navigation off center instead of overlapping it. */
      grid-template-columns: minmax(0, 1fr) auto 1fr;
      /* The theme insets the right edge on pages with a sidebar; drop the
         inset so the middle column is centered on the page. */
      padding-inline: 0;
    }

    .title-wrapper {
      justify-self: start;
      max-width: 100%;
    }

    :global(.header-nav) {
      justify-self: center;
    }

    .header-actions {
      display: flex;
      align-items: center;
      justify-self: end;
      /* Same height as the search button. */
      min-height: 2rem;
    }
  }
</style>
