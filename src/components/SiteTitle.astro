---
/*
 * Wraps the theme's site title and navigation. On desktop the theme's header
 * links are replaced by: the "Documentation" menu (the four documentation
 * sections), the "Packages" link and the "Demonstration" language menu. They
 * are rendered here, after the title, so that the keyboard order follows the
 * visual order. The theme's mobile menu keeps the flat `navLinks` of
 * astro.config.mjs: the section overviews, Packages and the English demo.
 *
 * The current item is marked with aria-current and an underline, in the
 * header and in the mobile menu. The theme renders the mobile menu without
 * knowledge of the page, so a script marks its items.
 */
import ThemeSiteTitle from "starlight-theme-black/overrides/SiteTitle.astro";
import DemoMenu from "./DemoMenu.astro";
import DocsMenu from "./DocsMenu.astro";
import { DEMO_URL } from "../data/demo-locales";
import { navigationState } from "../data/navigation-state";

const packagesState = navigationState(Astro.url.pathname, "/packages/");
---

<div class="site-title-with-menus" data-demo-url={DEMO_URL}>
  <ThemeSiteTitle />
  <DocsMenu class="header-menu" />
  <a class="header-link" href="/packages/" aria-current={packagesState}>
    Packages
  </a>
  <DemoMenu class="header-menu" />
</div>

<script>
  import { navigationState } from "../data/navigation-state";

  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    ".mobile-nav a[data-header-link]",
  )) {
    const url = new URL(link.href);
    if (url.origin !== location.origin) continue;
    const state = navigationState(location.pathname, url.pathname);
    if (state) link.setAttribute("aria-current", state);
  }
</script>

<style>
  .site-title-with-menus {
    display: flex;
    align-items: center;
  }

  /* The theme otherwise removes the brand entirely below 1024px. */
  .site-title-with-menus :global(.site-title) {
    display: flex;
    flex-shrink: 0;
  }

  @media (max-width: 1023px) {
    .site-title-with-menus {
      --sl-nav-gap: 0.75rem;
    }
  }

  @media (max-width: 26rem) {
    /* The trigger retains its screen-reader label beside the brand. */
    .site-title-with-menus :global(black-menu-button .label) {
      display: none;
    }
  }

  .site-title-with-menus :global(.header-menu),
  .header-link {
    display: none;
  }

  /* The current item of the mobile menu: an underline, which does not rely
     on colour. */
  .site-title-with-menus :global(.mobile-nav-links a[aria-current]) {
    text-decoration: underline 2px;
    text-underline-offset: 0.3em;
  }

  @media (min-width: 1024px) {
    .site-title-with-menus {
      gap: 0.375rem;
    }

    /* The theme's links are replaced by the items below. Its mobile menu
       button is hidden by the theme at this width, but the element would
       still take a gap. */
    .site-title-with-menus :global(.nav-bar),
    .site-title-with-menus :global(black-menu-button) {
      display: none;
    }

    .site-title-with-menus :global(.header-menu) {
      display: inline-block;
    }

    /* The theme separates the title and its nav links by --sl-nav-gap. */
    .site-title-with-menus :global(.docs-menu) {
      margin-inline-start: calc(var(--sl-nav-gap) - 0.375rem);
    }

    /* Starlight clips the title area to protect narrow screens from long
       titles; on desktop it would also clip the menus' lists. */
    :global(.header .title-wrapper) {
      overflow: visible;
    }

    /* Same look as the theme's nav links. */
    .header-link {
      display: inline-flex;
      align-items: center;
      min-height: 2rem;
      padding: 0 0.625rem;
      border-radius: calc(var(--radius) - 2px);
      color: var(--foreground);
      font-size: 0.875rem;
      font-weight: 500;
      line-height: 1.25rem;
      text-decoration: none;
      transition: background-color 0.15s;
    }

    .header-link[aria-current] {
      text-decoration: underline 2px;
      text-underline-offset: 0.35em;
    }

    .header-link:hover {
      background-color: color-mix(in oklab, var(--accent) 80%, transparent);
    }

    .header-link:focus-visible {
      outline: 2px solid var(--foreground);
      outline-offset: 2px;
    }
  }
</style>
