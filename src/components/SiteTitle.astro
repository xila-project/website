---
/*
 * Wraps the theme's site title (the logo and the name). On desktop (1024px
 * and above) the theme's nav bar is hidden here and the header renders its
 * own centered navigation (HeaderNav.astro, placed by Header.astro); below
 * that width the brand and the menu button stay visible, and the mobile
 * menu keeps the flat `navLinks` of astro.config.mjs.
 *
 * The current item is marked with aria-current and an underline, in the
 * header and in the mobile menu. The theme renders the mobile menu without
 * knowledge of the page, so a script marks its items.
 */
import ThemeSiteTitle from "starlight-theme-black/overrides/SiteTitle.astro";
---

<div class="site-title-block" data-pathname={Astro.url.pathname}>
  <ThemeSiteTitle />
</div>

<script>
  import { navigationState } from "../data/navigation-state";

  // The path of the rendered page, not location.pathname: the 404 page is
  // served at any missing path, and the header items are not marked on it.
  const pathname =
    document.querySelector<HTMLElement>(".site-title-block")?.dataset
      .pathname ?? location.pathname;

  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    ".mobile-nav a[data-header-link]",
  )) {
    const url = new URL(link.href);
    if (url.origin !== location.origin) continue;
    const state = navigationState(pathname, url.pathname);
    if (state) link.setAttribute("aria-current", state);
  }
</script>

<style>
  .site-title-block {
    display: flex;
    align-items: center;
  }

  /* The theme otherwise removes the brand entirely below 1024px. */
  .site-title-block :global(.site-title) {
    display: flex;
    flex-shrink: 0;
  }

  @media (max-width: 1023px) {
    .site-title-block {
      --sl-nav-gap: 0.75rem;
    }
  }

  @media (max-width: 26rem) {
    /* The trigger retains its screen-reader label beside the brand. */
    .site-title-block :global(black-menu-button .label) {
      display: none;
    }
  }

  /* The current item of the mobile menu: an underline, which does not rely
     on colour. */
  .site-title-block :global(.mobile-nav-links a[aria-current]) {
    text-decoration: underline 2px;
    text-underline-offset: 0.3em;
  }

  @media (min-width: 1024px) {
    /* The theme's links are replaced by the header's centered navigation.
       Its mobile menu button is hidden by the theme at this width, but the
       element would still take a gap. */
    .site-title-block :global(.nav-bar),
    .site-title-block :global(black-menu-button) {
      display: none;
    }
  }
</style>
