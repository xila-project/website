---
/*
 * The entry point of an API on its reference page: a link to the rustdoc
 * pages under /api/, and the redirect of the former viewer links.
 */
import { LinkCard } from "@astrojs/starlight/components";
import ApiRedirect from "./ApiRedirect.astro";
import { getApiRootHref } from "../../scripts/reference-path.mjs";

interface Props {
  architecture: "host" | "guest";
}

const { architecture } = Astro.props;
const title =
  architecture === "guest"
    ? "Guest API: wasm (wasm32-wasip1)"
    : "Host API: xila (x86_64-unknown-linux-gnu)";
---

<ApiRedirect architecture={architecture} />
<LinkCard
  title={title}
  description="Open the generated rustdoc: crates, modules, types, traits and functions."
  href={getApiRootHref(architecture)}
/>
