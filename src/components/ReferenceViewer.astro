---
import { getReferenceDefaultIframeSrc } from "../../scripts/reference-path.mjs";

const { architecture } = Astro.props;
const base = getReferenceDefaultIframeSrc(architecture);
const label = architecture === "guest" ? "wasm (wasm32-wasip1)" : "xila (host)";
---

<div class="reference-viewer-container" data-reference-viewer={architecture}>
  <div class="reference-viewer-toolbar">
    <span class="reference-viewer-title">
      Generated Rustdoc: <code data-reference-current>{label}</code>
    </span>
    <a
      href={base}
      target="_blank"
      rel="noopener noreferrer"
      class="reference-viewer-external"
      data-reference-open
    >
      Open standalone API index ↗
    </a>
  </div>
  <div class="reference-viewer">
    <iframe
      src={base}
      data-architecture={architecture}
      title={`${architecture} Rust API documentation`}></iframe>
  </div>
</div>

<script>
  import { getReferenceIframeSrc } from "../../scripts/reference-path.mjs";

  for (const container of document.querySelectorAll<HTMLElement>(
    "[data-reference-viewer]",
  )) {
    const frame = container.querySelector<HTMLIFrameElement>(
      "iframe[data-architecture]",
    );
    const openLink = container.querySelector<HTMLAnchorElement>(
      "[data-reference-open]",
    );
    const currentLabel = container.querySelector<HTMLElement>(
      "[data-reference-current]",
    );
    if (!frame) continue;

    const path = new URLSearchParams(window.location.search).get("path");
    if (path) {
      const targetSrc = getReferenceIframeSrc(frame.dataset.architecture, path);
      frame.src = targetSrc;
      if (openLink) {
        openLink.href = targetSrc;
      }
      if (currentLabel) {
        currentLabel.textContent = path;
      }
    }
  }
</script>

<style>
  .reference-viewer-container {
    margin: 1.5rem 0;
    scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--sl-color-bg-nav);
  }
  .reference-viewer-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid var(--sl-color-hairline-light);
    font-size: var(--sl-text-sm);
  }
  .reference-viewer-external {
    font-weight: 500;
    text-decoration: none;
  }
  .reference-viewer-external:hover {
    text-decoration: underline;
  }
  .reference-viewer {
    height: calc(100vh - var(--sl-nav-height) - 12rem);
    min-height: 36rem;
    width: 100%;
    background: #ffffff;
  }
  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
