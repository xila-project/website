---
/*
 * A link to an item of the Rust API documentation, resolved at build time
 * with the API index (scripts/api-links.mjs):
 *
 *   <Api path="task::Manager::spawn" />
 *   <Api path="wasm::Window" api="guest" />
 *   <Api path="network" />                    (a crate: "network crate")
 *   <Api path="task::Manager">the manager</Api>
 *
 * A path that does not resolve links to the rustdoc search and carries a
 * `data-api-error` attribute, which the documentation check reports, or a
 * `data-api-unchecked` attribute when the build has no API index. A resolved
 * link also carries the item kind in `data-api-kind` (styled by
 * src/styles/xila.css) and a visually hidden "(API reference)" text.
 */
import { resolveApiLink } from "../../scripts/api-links.mjs";
import { API_LINK_HIDDEN_TEXT } from "../../scripts/remark-api-links.mjs";

interface Props {
  path: string;
  api?: "host" | "guest";
}

const { path, api } = Astro.props;
const link = resolveApiLink(api ? `${api}:${path}` : path);
// Forward the slot only when it has content, so that the generated label is
// the fallback.
const label = Astro.slots.has("default")
  ? await Astro.slots.render("default")
  : undefined;
---

<a
  href={link.href}
  class="reference-link"
  data-api={link.api}
  data-api-kind={link.kind}
  data-api-error={link.error}
  data-api-unchecked={link.unchecked}
>
  {
    label === undefined ? (
      <>
        <code>{link.label}</code>
        {link.crate && " crate"}
      </>
    ) : (
      <Fragment set:html={label} />
    )
  }
  <span class="sr-only">{API_LINK_HIDDEN_TEXT}</span>
</a>
