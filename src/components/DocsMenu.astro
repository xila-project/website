---
/*
 * The "Documentation" header menu: the documentation overview and one entry
 * for each documentation section. It follows the structure and the styles of
 * DemoMenu. When the visitor is on the overview or inside one of the
 * sections, the trigger has aria-current="true" and the matching item has
 * aria-current ("page" on the overview page of the item).
 */
import { Icon } from "@astrojs/starlight/components";
import { DOCUMENTATION_SECTIONS } from "../data/documentation-sections";
import { navigationState } from "../data/navigation-state";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const sections = DOCUMENTATION_SECTIONS.map((section) => ({
  ...section,
  state: navigationState(Astro.url.pathname, section.href),
}));
const inside = sections.some(({ state }) => state);
---

<details class:list={["docs-menu", className]}>
  <summary aria-current={inside ? "true" : undefined}>
    Documentation
    <Icon name="down-caret" size="1rem" class="caret" />
  </summary>
  <ul role="list" aria-label="Documentation sections">
    {
      sections.map(({ label, description, href, state }) => (
        <li>
          <a href={href} aria-current={state}>
            <span class="label">{label}</span>
            <span class="description">{description}</span>
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  // Browsers expose the open state of the details element as the expanded
  // state of its summary, also without scripts. ARIA in HTML does not allow
  // aria-expanded on summary, so the script does not set it.
  const MENU = ".docs-menu";

  function close(menu: HTMLDetailsElement, restoreFocus = false) {
    menu.open = false;
    if (restoreFocus) menu.querySelector("summary")?.focus();
  }

  // "pointerdown" also fires for a touch on iOS, where "click" does not
  // reach the document for elements that are not interactive.
  document.addEventListener("pointerdown", (event) => {
    for (const menu of document.querySelectorAll<HTMLDetailsElement>(
      `${MENU}[open]`,
    )) {
      if (!menu.contains(event.target as Node)) close(menu);
    }
  });

  // Keyboard focus that leaves the menu closes it.
  document.addEventListener("focusin", (event) => {
    for (const menu of document.querySelectorAll<HTMLDetailsElement>(
      `${MENU}[open]`,
    )) {
      if (!menu.contains(event.target as Node)) close(menu);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    for (const menu of document.querySelectorAll<HTMLDetailsElement>(
      `${MENU}[open]`,
    )) {
      close(menu, true);
    }
  });
</script>

<style>
  .docs-menu {
    position: relative;
    display: inline-block;
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2rem;
    padding: 0 0.5rem 0 0.625rem;
    border-radius: calc(var(--radius) - 2px);
    color: var(--foreground);
    font-weight: 500;
    list-style: none;
    cursor: pointer;
    user-select: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover,
  .docs-menu[open] > summary {
    background-color: color-mix(in oklab, var(--accent) 80%, transparent);
  }

  summary:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: 2px;
  }

  /* The visitor is inside one of the sections: an underline, which does not
     rely on colour. */
  summary[aria-current] {
    text-decoration: underline 2px;
    text-underline-offset: 0.35em;
  }

  .caret {
    color: var(--muted-foreground);
    transition: transform 0.15s;
  }

  .docs-menu[open] .caret {
    transform: rotate(180deg);
  }

  ul {
    position: absolute;
    top: calc(100% + 0.375rem);
    left: 0;
    z-index: calc(var(--sl-z-index-navbar) + 1);
    min-width: 18rem;
    margin: 0;
    padding: 0.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--background);
    box-shadow: var(--sl-shadow-md);
    list-style: none;
    text-align: start;
  }

  a {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.5rem;
    border-radius: calc(var(--radius) - 4px);
    color: var(--foreground);
    text-decoration: none;
  }

  a:hover {
    background-color: var(--accent);
  }

  a:focus-visible {
    background-color: var(--accent);
    outline: 2px solid var(--foreground);
    outline-offset: -2px;
  }

  a[aria-current] {
    background-color: var(--accent);
  }

  .label {
    font-weight: 500;
  }

  a[aria-current] .label::after {
    content: "";
    display: inline-block;
    width: 0.375rem;
    height: 0.375rem;
    margin-inline-start: 0.5rem;
    border-radius: 50%;
    background-color: var(--foreground);
    vertical-align: middle;
  }

  .description {
    color: var(--muted-foreground);
    font-size: 0.75rem;
    line-height: 1rem;
  }
</style>
