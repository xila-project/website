---
/*
 * Wraps the theme's page title to add a metadata line under it: the
 * last-updated date (from git history) and a link to edit the page.
 */
import { Icon } from "@astrojs/starlight/components";
import ThemePageTitle from "starlight-theme-black/overrides/PageTitle.astro";
import PagefindIgnoreMarkdownActions from "./PagefindIgnoreMarkdownActions.astro";

const { lastUpdated, editUrl } = Astro.locals.starlightRoute;
const dateFormat = new Intl.DateTimeFormat("en", { dateStyle: "medium" });
---

<PagefindIgnoreMarkdownActions>
  <ThemePageTitle />
</PagefindIgnoreMarkdownActions>
{(lastUpdated || editUrl) && (
  <div class="page-meta-line not-content">
    {lastUpdated && (
      <span>
        <Icon name="clock" size="0.875rem" />
        Last updated
        <time datetime={lastUpdated.toISOString()}>
          {dateFormat.format(lastUpdated)}
        </time>
      </span>
    )}
    {editUrl && (
      <a href={editUrl}>
        <Icon name="pencil" size="0.875rem" />
        Edit page
      </a>
    )}
  </div>
)}

<style>
  .page-meta-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0;
    margin-top: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border, var(--sl-color-hairline));
    font-size: 0.8125rem;
    line-height: 1.25rem;
    color: var(--muted-foreground, var(--sl-color-gray-3));
  }
  .page-meta-line > * {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .page-meta-line > * + * {
    margin-inline-start: 0.75rem;
    padding-inline-start: 0.75rem;
    border-inline-start: 1px solid var(--border, var(--sl-color-hairline));
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--foreground, var(--sl-color-white));
  }
</style>
