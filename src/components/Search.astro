---
/*
 * Wraps Starlight's search (Pagefind in a dialog) with:
 * - an empty state shown until something is typed,
 * - a footer with keyboard hints,
 * - arrow-key navigation between results (Pagefind's UI has none), so the
 *   "Navigate" hint is true.
 * The extras are inserted into the dialog on the client; styles are global
 * because the dialog's content is rendered by Starlight and Pagefind.
 */
import { Icon } from "@astrojs/starlight/components";
import Default from "@astrojs/starlight/components/Search.astro";
---

<Default />
<template id="xila-search-extras">
  <div class="xila-search-empty" aria-hidden="true">
    <Icon name="magnifier" size="2.5rem" />
    <p>Start typing to search</p>
  </div>
  <div class="xila-search-footer">
    <span>
      <kbd>↑</kbd>
      <kbd>↓</kbd> Navigate
    </span>
    <span>
      <kbd>↵</kbd> Select
    </span>
    <span>
      <kbd>Esc</kbd> Close
    </span>
    <span class="powered">Search by Pagefind</span>
  </div>
</template>

<script>
  const PLACEHOLDER = "Search documentation...";
  const RESULT_LINKS =
    "#starlight__search .pagefind-ui__result-link, #starlight__search .pagefind-ui__result-nested .pagefind-ui__result-link";

  const dialog =
    document.querySelector<HTMLDialogElement>("site-search dialog");
  const frame = dialog?.querySelector(".dialog-frame");
  const extras = document.querySelector<HTMLTemplateElement>(
    "#xila-search-extras",
  );

  if (dialog && frame && extras) {
    frame.append(extras.content.cloneNode(true));

    // Pagefind creates its input lazily; set the placeholder once it exists.
    const setPlaceholder = () => {
      const input = frame.querySelector<HTMLInputElement>(
        ".pagefind-ui__search-input",
      );
      if (input && input.placeholder !== PLACEHOLDER) {
        input.placeholder = PLACEHOLDER;
      }
    };
    new MutationObserver(setPlaceholder).observe(frame, {
      childList: true,
      subtree: true,
    });
    setPlaceholder();

    dialog.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
      const links = [
        ...dialog.querySelectorAll<HTMLAnchorElement>(RESULT_LINKS),
      ];
      if (links.length === 0) return;
      const input = dialog.querySelector<HTMLInputElement>(
        ".pagefind-ui__search-input",
      );
      const index = links.indexOf(document.activeElement as HTMLAnchorElement);
      event.preventDefault();
      if (event.key === "ArrowDown") {
        links[Math.min(index + 1, links.length - 1)]?.focus();
      } else if (index <= 0) {
        input?.focus();
      } else {
        links[index - 1]?.focus();
      }
    });
  }
</script>

<style is:global>
  /* Header button: show the magnifier and the shortcut keys. */
  @media (min-width: 48rem) {
    site-search > button[data-open-modal] {
      gap: 0.5rem;
      border: 1px solid var(--border);
      background-color: transparent;
      color: var(--muted-foreground);
    }
    site-search > button[data-open-modal]:hover {
      border-color: var(--muted-foreground);
      color: var(--foreground);
    }
    site-search > button[data-open-modal] > svg {
      display: block;
      flex-shrink: 0;
      width: 1rem;
      height: 1rem;
    }
    site-search > button[data-open-modal] > kbd {
      display: flex;
      gap: 0.25rem;
      margin-inline-start: auto;
      padding: 0;
      border: 0;
      background: none;
    }
    site-search > button[data-open-modal] > kbd > kbd {
      min-width: 1.25rem;
      padding: 0 0.3rem;
      border: 1px solid var(--border);
      border-radius: 0.25rem;
      background-color: var(--muted);
      color: var(--muted-foreground);
      font-family: var(--sl-font-mono, ui-monospace, monospace);
      font-size: 0.6875rem;
      line-height: 1.125rem;
      text-align: center;
    }
  }

  /* Dialog: compact, with the input separated from the results by a rule. */
  @media (min-width: 50rem) {
    site-search dialog {
      max-width: 37.5rem;
      min-height: 0;
      border: 1px solid var(--border);
      border-radius: calc(var(--radius) + 0.25rem);
      background-color: var(--background);
      overflow: hidden;
    }
    site-search dialog .dialog-frame {
      padding: 0;
    }
  }

  site-search .dialog-frame {
    flex-direction: column;
  }

  site-search .search-container {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
  }

  #starlight__search .pagefind-ui__form::before {
    left: 1rem;
    opacity: 0.6;
  }

  #starlight__search .pagefind-ui__search-input {
    height: 3.25rem;
    padding-inline-start: 2.75rem;
    border: 0;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    background-color: transparent;
    color: var(--foreground);
    font-size: 1rem;
    font-weight: 400;
  }

  #starlight__search .pagefind-ui__search-input:focus {
    outline: none;
  }

  #starlight__search .pagefind-ui__search-clear {
    right: 0.75rem;
    background-color: transparent;
  }

  #starlight__search .pagefind-ui__drawer {
    padding: 0.5rem 1rem 1rem;
  }

  #starlight__search .pagefind-ui__result-link:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  /* Empty state, shown until something is typed. */
  .xila-search-empty {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 2.5rem 1rem 3rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .xila-search-empty p {
    margin: 0;
  }

  site-search
    dialog:not(:has(.pagefind-ui__search-input:not(:placeholder-shown)))
    .xila-search-empty {
    display: flex;
  }

  /* Footer with keyboard hints, for devices with a keyboard-sized screen. */
  .xila-search-footer {
    display: none;
    align-items: center;
    gap: 1rem;
    padding: 0.625rem 1rem;
    border-top: 1px solid var(--border);
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }

  @media (min-width: 50rem) {
    .xila-search-footer {
      display: flex;
    }
  }

  .xila-search-footer > span {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .xila-search-footer .powered {
    margin-inline-start: auto;
  }

  .xila-search-footer kbd {
    min-width: 1.25rem;
    padding: 0 0.3rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    background-color: var(--muted);
    font-family: inherit;
    font-size: 0.6875rem;
    line-height: 1.125rem;
    text-align: center;
  }
</style>
