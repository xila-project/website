---
/*
 * Sidebar list, derived from starlight-theme-black's SidebarSublist (MIT).
 *
 * Differences from the theme:
 * - A group's "Overview" link is not listed; the group label links to it
 *   instead. Top-level groups become section headings, nested groups stay
 *   collapsible (the caret toggles, the label navigates).
 * - Rows grow when long labels wrap with Montserrat.
 *
 * The "Overview" entries stay in astro.config.mjs: they give each group its
 * landing page and keep breadcrumbs and previous/next links working.
 */
import type { StarlightRouteData } from "@astrojs/starlight/route-data";
import { Icon } from "@astrojs/starlight/components";
import SidebarRestorePoint from "@astrojs/starlight/components/SidebarRestorePoint.astro";

type Entry = StarlightRouteData["sidebar"][number];
type Link = Extract<Entry, { type: "link" }>;

interface Props {
  sublist: Entry[];
  nested?: boolean;
}

const { sublist, nested = false } = Astro.props;

const flatten = (entries: Entry[]): Link[] =>
  entries.flatMap((e) => (e.type === "group" ? flatten(e.entries) : e));
const overviewOf = (entries: Entry[]) =>
  entries.find((e): e is Link => e.type === "link" && e.label === "Overview");
---

<ul class:list={{ "top-level": !nested }}>
  {sublist.map((entry) => {
    if (entry.type === "link") {
      return (
        <li>
          <a
            href={entry.href}
            aria-current={entry.isCurrent && "page"}
            {...entry.attrs}
            class:list={["entry-link", entry.attrs.class]}
          >
            {entry.label}
          </a>
        </li>
      );
    }

    const overview = overviewOf(entry.entries);
    const children = entry.entries.filter((e) => e !== overview);
    const label = overview ? (
      <a
        class="group-link"
        href={overview.href}
        aria-current={overview.isCurrent && "page"}
      >
        {entry.label}
      </a>
    ) : (
      <span>{entry.label}</span>
    );

    if (!nested) {
      return (
        <li class="section" data-sidebar-group>
          <div class="section-title" data-group-label>
            {label}
          </div>
          <Astro.self sublist={children} nested />
        </li>
      );
    }

    const open =
      flatten(entry.entries).some((link) => link.isCurrent) || !entry.collapsed;
    return (
      <li>
        <details class="group" open={open} data-sidebar-group>
          <summary class="group-title" data-group-label>
            {label}
            <Icon name="right-caret" class="caret" size="1rem" />
          </summary>
          <SidebarRestorePoint />
          <div class="group-content">
            <Astro.self sublist={children} nested />
          </div>
        </details>
      </li>
    );
  })}
</ul>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .section {
    padding-top: 1.25rem;
  }

  .top-level > .section:first-child {
    padding-top: 0.5rem;
  }

  .section-title {
    padding: 0 0.5rem 0.375rem;
    color: var(--muted-foreground);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .section-title > a {
    color: inherit;
    text-decoration: none;
  }

  .section-title > a:hover,
  .section-title > a[aria-current="page"] {
    color: var(--foreground);
  }

  .entry-link,
  .group-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--foreground);
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.35;
    text-decoration: none;
  }

  .entry-link {
    width: fit-content;
    min-height: 30px;
    padding: 6px 0.5rem;
    border-radius: calc(var(--radius) * 0.8);
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .entry-link:hover,
  .entry-link[aria-current="page"],
  .group-title:has(> .group-link[aria-current="page"]) {
    background-color: var(--accent);
    color: var(--sidebar-accent-foreground, var(--foreground));
  }

  summary.group-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 30px;
    padding: 6px 0.5rem;
    border-radius: calc(var(--radius) * 0.8);
    color: var(--foreground);
    font-size: 0.8rem;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
    user-select: none;
  }

  summary.group-title::-webkit-details-marker {
    display: none;
  }

  summary.group-title:hover {
    background-color: var(--accent);
  }

  .caret {
    flex-shrink: 0;
    color: var(--muted-foreground);
    transition: transform 0.2s ease-in-out;
  }

  details[open] > summary > .caret {
    transform: rotate(90deg);
  }

  :global([dir="rtl"]) .caret {
    transform: rotate(180deg);
  }

  .group-content {
    margin: 0.25rem 0 0 0.875rem;
    padding-inline-start: 0.375rem;
    border-inline-start: 1px solid var(--border);
  }
</style>
