---
/*
 * Wraps the theme's hero to render its action buttons here, so the button
 * linking to the browser demonstration can open the language menu. The
 * actions still come from the page's `hero.actions` frontmatter.
 *
 * The theme's hero reads the current route, so it is given a copy of the
 * route entry without actions; the shared content entry is not modified.
 */
import { LinkButton } from "starlight-theme-black/components";
import ThemeHero from "starlight-theme-black/overrides/Hero.astro";
import DemoMenu from "./DemoMenu.astro";
import { DEMO_URL } from "../data/demo-locales";

const route = Astro.locals.starlightRoute;
const hero = route.entry.data.hero;
const actions = hero?.actions ?? [];
const isHome = Astro.url.pathname === "/";

if (hero && actions.length > 0) {
  route.entry = {
    ...route.entry,
    data: { ...route.entry.data, hero: { ...hero, actions: [] } },
  };
}
---

<div class:list={{ "homepage-hero": isHome }}>
  <div class="hero-copy">
    <ThemeHero />
    {actions.length > 0 && (
      <div class="hero-actions">
        {actions.map(({ attrs = {}, icon, link, text, variant }) =>
          link === DEMO_URL ? (
            <DemoMenu label={text} variant={variant} />
          ) : (
            <LinkButton href={link} {variant} icon={icon?.name} {...attrs}>
              {text}
              {icon?.html && <Fragment set:html={icon.html} />}
            </LinkButton>
          ),
        )}
      </div>
    )}
  </div>
  {isHome && (
    <div class="hero-brand" aria-hidden="true">
      <div class="hero-orbits">
        <span class="orbit orbit-inner">
          <i />
        </span>
        <span class="orbit orbit-outer">
          <i />
          <i />
        </span>
        <span class="orbit-crosshair" />
      </div>
      <img
        class="light:sl-hidden"
        src="/images/logo_dark.svg"
        alt=""
        width="256"
        height="256"
        decoding="async"
      />
      <img
        class="dark:sl-hidden"
        src="/images/logo_light.svg"
        alt=""
        width="256"
        height="256"
        decoding="async"
      />
    </div>
  )}
  {isHome && (
    <a class="hero-scroll" href="#get-started">
      Explore Xila <span aria-hidden="true">↓</span>
    </a>
  )}
</div>

<style>
  :global(body:has(.homepage-hero)) {
    overflow-x: clip;
  }

  .homepage-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    min-height: calc(100svh - var(--sl-nav-height, 4rem));
    padding-block: 4rem 6rem;
  }

  .homepage-hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0 calc(50% - 50vw);
    pointer-events: none;
    background-image: radial-gradient(
      circle,
      currentColor 0.75px,
      transparent 1px
    );
    background-size: 28px 28px;
    opacity: 0.13;
    mask-image:
      linear-gradient(transparent, #000 18%, #000 70%, transparent),
      linear-gradient(90deg, transparent, #000);
    mask-composite: intersect;
  }

  .hero-copy {
    min-width: 0;
    width: 100%;
  }

  .homepage-hero :global(.hero) {
    padding-top: 0;
  }

  .hero-brand {
    position: relative;
    display: grid;
    place-items: center;
    order: -1;
    width: 4.5rem;
    flex-shrink: 0;
  }

  .hero-brand img {
    position: relative;
    width: 100%;
    height: auto;
  }

  .hero-orbits {
    position: absolute;
    inset: -65%;
    pointer-events: none;
    color: var(--foreground);
  }

  .orbit {
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    border-radius: 50%;
    animation: orbit-turn 90s linear infinite;
  }

  .orbit-inner {
    inset: 14%;
    animation-duration: 65s;
    animation-direction: reverse;
  }

  .orbit-outer {
    border-style: dashed;
  }

  .orbit i {
    position: absolute;
    top: 50%;
    left: 0;
    width: 0.5rem;
    height: 0.5rem;
    background: currentColor;
    opacity: 0.45;
    transform: translate(-50%, -50%);
  }

  .orbit i + i {
    left: 100%;
    width: 0.3rem;
    height: 0.3rem;
  }

  .orbit-crosshair {
    position: absolute;
    inset: -8%;
    opacity: 0.09;
    background:
      linear-gradient(currentColor, currentColor) center / 100% 1px no-repeat,
      linear-gradient(currentColor, currentColor) center / 1px 100% no-repeat;
    transform: rotate(45deg);
  }

  .hero-scroll {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transform: translateX(-50%);
    color: var(--muted-foreground);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .hero-scroll:hover {
    color: var(--foreground);
  }

  @keyframes orbit-turn {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit {
      animation: none;
    }
  }

  @media (max-width: 1023px) {
    .hero-orbits {
      inset: -45%;
    }
  }

  @media (min-width: 1024px) {
    .homepage-hero {
      display: grid;
      grid-template-columns: minmax(0, 40rem) minmax(12rem, 1fr);
      align-items: center;
      gap: clamp(2rem, 5vw, 5rem);
      padding-block: 5rem 7rem;
    }

    .hero-brand {
      order: 0;
      justify-self: center;
      width: clamp(12rem, 20vw, 16rem);
      margin-bottom: 0;
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-block: 0.5rem 2.5rem;
  }

  /* Matches the theme's left-aligned hero from its desktop breakpoint. */
  @media (min-width: 1024px) {
    .hero-actions {
      justify-content: flex-start;
    }
  }
</style>
