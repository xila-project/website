---
/*
 * Wraps the theme's hero to render its action buttons here, so the button
 * linking to the browser demonstration can open the language menu. The
 * actions still come from the page's `hero.actions` frontmatter.
 *
 * The theme's hero reads the current route, so it is given a copy of the
 * route entry without actions; the shared content entry is not modified.
 */
import { LinkButton } from "starlight-theme-black/components";
import ThemeHero from "starlight-theme-black/overrides/Hero.astro";
import DemoMenu from "./DemoMenu.astro";
import { DEMO_URL } from "../data/demo-locales";

const route = Astro.locals.starlightRoute;
const hero = route.entry.data.hero;
const actions = hero?.actions ?? [];
const isHome = Astro.url.pathname === "/";

if (hero && actions.length > 0) {
  route.entry = {
    ...route.entry,
    data: { ...route.entry.data, hero: { ...hero, actions: [] } },
  };
}
---

<div class:list={{ "homepage-hero": isHome }}>
  <div class="hero-copy">
    <ThemeHero />
    {actions.length > 0 && (
      <div class="hero-actions">
        {actions.map(({ attrs = {}, icon, link, text, variant }) =>
          link === DEMO_URL ? (
            <DemoMenu label={text} variant={variant} />
          ) : (
            <LinkButton href={link} {variant} icon={icon?.name} {...attrs}>
              {text}
              {icon?.html && <Fragment set:html={icon.html} />}
            </LinkButton>
          ),
        )}
      </div>
    )}
  </div>
  {isHome && (
    <div class="hero-brand" aria-hidden="true">
      <div class="hero-orbits">
        <span class="orbit orbit-inner">
          <i />
        </span>
        <span class="orbit orbit-outer">
          <i />
          <i />
        </span>
        <span class="orbit-crosshair" />
      </div>
      <svg
        class="hero-logo"
        viewBox="0 0 64 64"
        width="256"
        height="256"
        focusable="false"
      >
        <g fill="currentColor" transform="scale(0.1036504388948272)">
          <rect class="logo-center" height="118.02" rx="4.4" ry="4.4" width="118.02" x="249.72" y="249.72"/>
          <path class="logo-arm logo-arm-bottom-right" d="M374.18,403.63h-36.85v66.01c0,6.66,2.65,13.05,7.36,17.76l122.69,122.69c4.71,4.71,11.1,7.36,17.76,7.36h107.18c13.87,0,25.12-11.25,25.12-25.12v-107.21c0-6.66-2.65-13.05-7.36-17.76l-122.67-122.67c-4.71-4.71-11.1-7.36-17.76-7.36h-66.01v36.85c0,16.2-13.25,29.45-29.45,29.45Z" />
          <path class="logo-arm logo-arm-top-right" d="M403.63,243.27v36.85h66.01c6.66,0,13.05-2.65,17.76-7.36l122.69-122.69c4.71-4.71,7.36-11.1,7.36-17.76V25.14c0-13.87-11.25-25.12-25.12-25.12h-107.21c-6.66,0-13.05,2.65-17.76,7.36l-122.67,122.67c-4.71,4.71-7.36,11.1-7.36,17.76v66.01h36.85c16.2,0,29.45,13.25,29.45,29.45Z" />
          <path class="logo-arm logo-arm-top-left" d="M243.27,213.82h36.85v-66.01c0-6.66-2.65-13.05-7.36-17.76L150.08,7.36c-4.71-4.71-11.1-7.36-17.76-7.36H25.14C11.26,0,.02,11.25.02,25.12v107.21c0,6.66,2.65,13.05,7.36,17.76l122.67,122.67c4.71,4.71,11.1,7.36,17.76,7.36h66.01v-36.85c0-16.2,13.25-29.45,29.45-29.45Z" />
          <path class="logo-arm logo-arm-bottom-left" d="M213.82,374.18v-36.85h-66.01c-6.66,0-13.05,2.65-17.76,7.36L7.36,467.38c-4.71,4.71-7.36,11.1-7.36,17.76v107.18c0,13.87,11.25,25.12,25.12,25.12h107.21c6.66,0,13.05-2.65,17.76-7.36l122.67-122.67c4.71-4.71,7.36-11.1,7.36-17.76v-66.01h-36.85c-16.2,0-29.45-13.25-29.45-29.45Z" />
        </g>
      </svg>
    </div>
  )}
  {isHome && (
    <a class="hero-scroll" href="#get-started">
      Explore Xila <span aria-hidden="true">↓</span>
    </a>
  )}
</div>

<style>
  :global(body:has(.homepage-hero)) {
    overflow-x: clip;
  }

  .homepage-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    min-height: calc(100svh - var(--sl-nav-height, 4rem));
    padding-block: 4rem 6rem;
  }

  .homepage-hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0 calc(50% - 50vw);
    pointer-events: none;
    background-image: radial-gradient(
      circle,
      currentColor 0.75px,
      transparent 1px
    );
    background-size: 28px 28px;
    opacity: 0.13;
    mask-image:
      linear-gradient(transparent, #000 18%, #000 70%, transparent),
      linear-gradient(90deg, transparent, #000);
    mask-composite: intersect;
  }

  .hero-copy {
    min-width: 0;
    width: 100%;
  }

  .homepage-hero :global(.hero) {
    padding-top: 0;
  }

  .hero-brand {
    position: relative;
    display: grid;
    place-items: center;
    order: -1;
    width: 4.5rem;
    flex-shrink: 0;
  }

  .hero-logo {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    color: var(--foreground);
    overflow: visible;
  }

  /*
   * Same motion as the device boot splash: the centre appears, then each arm
   * slides in along its diagonal, clockwise from the top left. It plays once;
   * hovering ripples the arms outward in turn, as the splash does while
   * loading. Rest state is the plain logo, so every animation only needs
   * its starting frames.
   */
  .logo-center,
  .logo-arm {
    transform-box: fill-box;
    transform-origin: center;
  }

  .logo-center {
    animation: logo-center-in 300ms ease-out backwards;
  }

  .logo-arm {
    --out-x: 1;
    --out-y: 1;
    animation: logo-arm-in 480ms cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
  }

  .logo-arm-top-left {
    --out-x: -1;
    --out-y: -1;
    animation-delay: 150ms;
  }

  .logo-arm-top-right {
    --out-y: -1;
    animation-delay: 270ms;
  }

  .logo-arm-bottom-right {
    animation-delay: 390ms;
  }

  .logo-arm-bottom-left {
    --out-x: -1;
    animation-delay: 510ms;
  }

  .hero-brand:hover .logo-arm {
    animation: logo-arm-ripple 800ms ease-in-out;
  }

  .hero-brand:hover .logo-arm-top-left {
    animation-delay: 0ms;
  }

  .hero-brand:hover .logo-arm-top-right {
    animation-delay: 200ms;
  }

  .hero-brand:hover .logo-arm-bottom-right {
    animation-delay: 400ms;
  }

  .hero-brand:hover .logo-arm-bottom-left {
    animation-delay: 600ms;
  }

  @keyframes logo-center-in {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }

  @keyframes logo-arm-in {
    from {
      opacity: 0;
      /* User units of the brand path (about a fifth of an arm). */
      transform: translate(calc(var(--out-x) * 70px), calc(var(--out-y) * 70px));
    }
  }

  @keyframes logo-arm-ripple {
    50% {
      opacity: 0.7;
      transform: translate(calc(var(--out-x) * 22px), calc(var(--out-y) * 22px));
    }
  }

  .hero-orbits {
    position: absolute;
    inset: -65%;
    pointer-events: none;
    color: var(--foreground);
  }

  .orbit {
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    border-radius: 50%;
    animation: orbit-turn 90s linear infinite;
  }

  .orbit-inner {
    inset: 14%;
    animation-duration: 65s;
    animation-direction: reverse;
  }

  .orbit-outer {
    border-style: dashed;
  }

  .orbit i {
    position: absolute;
    top: 50%;
    left: 0;
    width: 0.5rem;
    height: 0.5rem;
    background: currentColor;
    opacity: 0.45;
    transform: translate(-50%, -50%);
  }

  .orbit i + i {
    left: 100%;
    width: 0.3rem;
    height: 0.3rem;
  }

  .orbit-crosshair {
    position: absolute;
    inset: -8%;
    opacity: 0.09;
    background:
      linear-gradient(currentColor, currentColor) center / 100% 1px no-repeat,
      linear-gradient(currentColor, currentColor) center / 1px 100% no-repeat;
    transform: rotate(45deg);
  }

  .hero-scroll {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transform: translateX(-50%);
    color: var(--muted-foreground);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .hero-scroll:hover {
    color: var(--foreground);
  }

  @keyframes orbit-turn {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit,
    .logo-center,
    .logo-arm,
    .hero-brand:hover .logo-arm {
      animation: none;
    }
  }

  @media (max-width: 1023px) {
    .hero-orbits {
      inset: -45%;
    }
  }

  @media (min-width: 1024px) {
    .homepage-hero {
      display: grid;
      grid-template-columns: minmax(0, 40rem) minmax(12rem, 1fr);
      align-items: center;
      gap: clamp(2rem, 5vw, 5rem);
      padding-block: 5rem 7rem;
    }

    .hero-brand {
      order: 0;
      justify-self: center;
      width: clamp(12rem, 20vw, 16rem);
      margin-bottom: 0;
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-block: 0.5rem 2.5rem;
  }

  /* Matches the theme's left-aligned hero from its desktop breakpoint. */
  @media (min-width: 1024px) {
    .hero-actions {
      justify-content: flex-start;
    }
  }
</style>
