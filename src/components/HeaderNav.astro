---
/*
 * The desktop navigation of the header: the "Documentation" menu, the
 * "Packages" link and the "Demonstration" link. Header.astro places it in
 * the middle column of the header grid, so it stays centered on the page.
 * Below 1024px it is hidden; the mobile menu keeps the flat `navLinks` of
 * astro.config.mjs.
 *
 * The current item is marked with aria-current and an underline, computed
 * in src/data/navigation-state.ts.
 */
import DocsMenu from "./DocsMenu.astro";
import { DEMONSTRATION_PAGE } from "../data/demonstration-locales";
import { navigationState } from "../data/navigation-state";

const packagesState = navigationState(Astro.url.pathname, "/packages/");
const demonstrationState = navigationState(
  Astro.url.pathname,
  DEMONSTRATION_PAGE,
);
---

<nav class="header-nav" aria-label="Main">
  <DocsMenu />
  <a class="header-link" href="/packages/" aria-current={packagesState}>
    Packages
  </a>
  <a
    class="header-link"
    href={DEMONSTRATION_PAGE}
    aria-current={demonstrationState}
  >
    Demonstration
  </a>
</nav>

<style>
  .header-nav {
    display: none;
  }

  @media (min-width: 64rem) {
    .header-nav {
      display: flex;
      align-items: center;
      gap: 0.375rem;
    }
  }

  /* Same look as the theme's nav links. */
  .header-link {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0 0.625rem;
    border-radius: calc(var(--radius) - 2px);
    color: var(--foreground);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25rem;
    text-decoration: none;
    transition: background-color 0.15s;
  }

  .header-link[aria-current] {
    text-decoration: underline 2px;
    text-underline-offset: 0.35em;
  }

  .header-link:hover {
    background-color: color-mix(in oklab, var(--accent) 80%, transparent);
  }

  .header-link:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: 2px;
  }
</style>
