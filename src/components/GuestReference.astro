---
import Reference from "./Reference.astro";
const props = Astro.props;
// Forward the slot only when it has content, so Reference can fall back to
// its generated label.
const label = Astro.slots.has("default")
  ? await Astro.slots.render("default")
  : undefined;
---

{label === undefined ? (
  <Reference {...props} architecture="guest" />
) : (
  <Reference {...props} architecture="guest">
    <Fragment set:html={label} />
  </Reference>
)}
