---
import LegacyRedirect from "@/components/LegacyRedirect.astro";

const target = "/how-to/manage-browser-disks/";
// Fragments of the old "Manage browser disks" page, mapped to the section
// with the same name of the renamed page.
const fragments: Record<string, string> = {
  "before-you-begin": `${target}#before-you-begin`,
  steps: `${target}#steps`,
  "create-a-new-disk": `${target}#create-a-new-disk`,
  "switch-between-saved-disks": `${target}#switch-between-saved-disks`,
  "remove-an-unused-disk": `${target}#remove-an-unused-disk`,
  "reset-storage-using-browser-developer-tools": `${target}#reset-storage-using-browser-developer-tools`,
  "verify-the-result": `${target}#verify-the-result`,
  troubleshooting: `${target}#troubleshooting`,
  related: `${target}#related`,
};
---

<LegacyRedirect target={target} fragments={fragments} />
